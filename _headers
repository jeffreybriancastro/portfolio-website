# Cloudflare Pages headers, the same set vercel.json gives the Vercel deploy.
# Keep the two in step when either changes.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# CSS and JS are versioned with ?v= in the pages, so an hour is safe.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/img/*
  Cache-Control: public, max-age=31536000, immutable

# The GoHighLevel pages on jeffreybrianbuilds.com load their scripts, styles and
# images from this host. Module scripts (barrel.js) and WebGL textures (the
# barrel's screenshots) are fetched in CORS mode, so without this header the
# browser refuses them on the other origin. Everything here is public anyway.
/js/*
  Access-Control-Allow-Origin: *
/css/*
  Access-Control-Allow-Origin: *
/img/*
  Access-Control-Allow-Origin: *
# The template draws its tool and social logos as CSS masks, which are also
# fetched in CORS mode, and the Poppins fonts live under /css/fonts/.
/icons/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
/og.png
  Cache-Control: public, max-age=31536000, immutable
